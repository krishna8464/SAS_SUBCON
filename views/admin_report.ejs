<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SAS_SUBCON - Admin Report</title>
  <link rel="stylesheet" href="/css/theme.css"><link rel="stylesheet" href="/css/company_brand.css"><script src="/js/theme_manager.js"></script><script src="/js/company_brand.js"></script><script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    };
  </script>
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <header class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl mb-6">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500 to-cyan-500 text-lg font-black text-slate-950">
            <%= (user && user.name ? user.name.charAt(0).toUpperCase() : 'A') %>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.28em] text-violet-400 font-bold">SAS_SUBCON</p>
            <h1 class="text-3xl font-black mt-1">Admin Operations Report</h1>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-left min-w-[220px]">
            <div class="text-[10px] uppercase tracking-[0.2em] text-slate-500">Reporting user</div>
            <div class="mt-1 text-sm font-bold text-white"><%= user && user.name ? user.name : 'Admin User' %></div>
            <div class="text-[11px] text-slate-400"><%= user && user.email ? user.email : 'N/A' %></div>
          </div>
          <a href="/user/dashboard-view" class="bg-slate-800 border border-slate-700 hover:border-violet-500/40 hover:bg-slate-900 text-slate-200 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-[0.2em] transition">Back to Dashboard</a>
        </div>
      </div>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
        <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 mb-3">Total Requests</p>
        <div class="text-3xl font-black text-white"><%= stats.total %></div>
      </div>
      <div class="bg-amber-500/10 border border-amber-500/20 rounded-2xl p-5">
        <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300 mb-3">Pending</p>
        <div class="text-3xl font-black text-amber-200"><%= stats.pending %></div>
      </div>
      <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-2xl p-5">
        <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-300 mb-3">Approved</p>
        <div class="text-3xl font-black text-emerald-200"><%= stats.approved %></div>
      </div>
      <div class="bg-rose-500/10 border border-rose-500/20 rounded-2xl p-5">
        <p class="text-[10px] uppercase tracking-[0.2em] text-rose-300 mb-3">Rejected</p>
        <div class="text-3xl font-black text-rose-200"><%= stats.rejected %></div>
      </div>
    </section>

    <section class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
      <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between gap-3">
        <div>
          <p class="text-[10px] uppercase tracking-[0.25em] text-violet-400 font-bold">Request Ledger</p>
          <h2 class="text-xl font-black mt-1 text-white">All Mobilization Requests</h2>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-950/70 text-slate-400 uppercase tracking-wider text-[10px]">
            <tr>
              <th class="px-4 py-3">Worker</th>
              <th class="px-4 py-3">Supplier</th>
              <th class="px-4 py-3">Site</th>
              <th class="px-4 py-3">Designation</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Medical / HSE</th>
              <th class="px-4 py-3">Created</th>
            </tr>
          </thead>
          <tbody>
            <% if (!requests || !requests.length) { %>
              <tr>
                <td colspan="7" class="px-4 py-10 text-center text-slate-500 text-xs uppercase tracking-wider">No mobilization requests available.</td>
              </tr>
            <% } else { %>
              <% requests.forEach(function(request) { %>
                <tr class="border-t border-slate-800 hover:bg-slate-950/40 transition">
                  <td class="px-4 py-4">
                    <div class="font-bold text-white"><%= request.employee_name || 'N/A' %></div>
                    <div class="text-[10px] text-slate-500 font-mono"><%= request.civil_id || 'N/A' %></div>
                  </td>
                  <td class="px-4 py-4">
                    <div class="text-slate-200"><%= request.sub_company_id && request.sub_company_id.supplier_name ? request.sub_company_id.supplier_name : 'N/A' %></div>
                    <div class="text-[10px] text-slate-500"><%= request.sub_company_id && request.sub_company_id.contact_email ? request.sub_company_id.contact_email : 'N/A' %></div>
                  </td>
                  <td class="px-4 py-4">
                    <div class="text-slate-200"><%= request.target_site_id && request.target_site_id.site_name ? request.target_site_id.site_name : 'N/A' %></div>
                    <div class="text-[10px] text-slate-500"><%= request.target_site_id && request.target_site_id.site_code ? request.target_site_id.site_code : 'N/A' %></div>
                  </td>
                  <td class="px-4 py-4 text-slate-200">
                    <%= request.designation_id && request.designation_id.title ? request.designation_id.title : 'N/A' %>
                  </td>
                  <td class="px-4 py-4">
                    <% let badgeClass = 'bg-slate-800 text-slate-300 border border-slate-700'; %>
                    <% if (request.status === 'Approved' || request.status === 'Pending Site Admin') badgeClass = 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20'; %>
                    <% if (request.status === 'Under Review' || request.status === 'Pending HO Approval') badgeClass = 'bg-amber-500/10 text-amber-300 border border-amber-500/20'; %>
                    <% if (request.status === 'Rejected') badgeClass = 'bg-rose-500/10 text-rose-300 border border-rose-500/20'; %>
                    <span class="inline-flex px-2 py-1 rounded-full text-[10px] uppercase tracking-wider font-black <%= badgeClass %>"><%= request.status %></span>
                  </td>
                  <td class="px-4 py-4 text-slate-200">
                    <div><span class="text-slate-400">Med:</span> <%= request.medical_status || 'Pending' %></div>
                    <div><span class="text-slate-400">HSE:</span> <%= request.hse_status || 'Pending' %></div>
                  </td>
                  <td class="px-4 py-4 text-slate-500 text-[11px]">
                    <%= new Date(request.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</body>
</html>
